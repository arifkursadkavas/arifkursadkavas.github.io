#!/bin/bash

#npm run test
rm -rf .next out
npm run build
mv ./out/_next ./out/next
cd ./out 

 #rename all paths containing next to next
if [[ $OSTYPE == 'darwin'* ]]; then
  #echo 'macOS'
  grep -rliI --exclude="deploy" --exclude="*.parquet" '_next' * | xargs -I@ sed -i '' 's/_next/next/g' @
else
    #echo 'LINUX'
    grep -rliI --exclude="deploy" --exclude="*.parquet" '_next' | xargs  sed -i 's/_next/next/g'
fi

#remove all paths inside files starting with /_ to /
if [[ $OSTYPE == 'darwin'* ]]; then
  #echo 'macOS'
  grep -rliI --exclude="deploy" --exclude="*.parquet" '/_'  * | xargs -I@ sed -i '' 's/\/_/\//g' @
else
  #echo 'LINUX'
  grep -rliI --exclude="deploy" --exclude="*.parquet" '/_' | xargs  sed -i 's/\/_/\//g'
fi


#rename all files starting with _ to remove it.
while IFS= read -r -d '' path; do
  name=${path##*/}
  mv "$path" "${path%/*}/${name#_}"
done < <(find . -depth -name '_*' -print0)

cp ../sitemap.xml .

cd ..
cp -rf ./out/* .
git add .
git commit -m "$1"
git push
